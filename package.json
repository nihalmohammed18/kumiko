{
  "name": "kumiko-ui",
  "version": "0.0.0-development",
  "description": "Playful React components in the spirit of Duolingo: tactile buttons, characters and celebrations. Built on Base UI and Tailwind CSS, accessible, with dark mode and right-to-left support.",
  "license": "MIT",
  "author": "Nihal Mohammed",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nihalmohammed18/kumiko.git"
  },
  "homepage": "https://nihalmohammed18.github.io/kumiko/",
  "keywords": [
    "react",
    "components",
    "ui",
    "base-ui",
    "tailwindcss",
    "design-system",
    "duolingo-style",
    "playful",
    "gamification",
    "characters",
    "rtl",
    "dark-mode"
  ],
  "files": [
    "dist",
    "llms.txt"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "default": "./dist/email/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "tokens": "node scripts/build-tokens.ts",
    "build": "node scripts/build-tokens.ts && rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-css.ts && node scripts/check.ts --dist && node scripts/agent-docs.ts",
    "size": "node scripts/size.ts",
    "build:storybook": "storybook build -o storybook-static --quiet",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "guard": "node scripts/check.ts",
    "check": "biome ci . && tsc --noEmit && node scripts/check.ts && vitest run --project unit",
    "test": "vitest run --project light --project dark --project rtl --project touch --project forced --project motion",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --project light --coverage",
    "vrt:docker": "sh scripts/vrt-docker.sh",
    "validate": "publint && attw --pack --profile esm-only --exclude-entrypoints styles.css fonts.css"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/baloo-bhaijaan-2": "5.3.0",
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "lucide-react": "^1.57.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.15",
    "@hookform/resolvers": "5.9.2",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.4",
    "@vitest/coverage-v8": "5.0.4",
    "playwright": "1.64.1",
    "publint": "0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.91.0",
    "semantic-release": "25.0.9",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@11.28.5",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.11.0",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
